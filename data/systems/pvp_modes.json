  "mechanics": {
    "naval_pvp": {
      "description": "Ship-based PvP battles where players equip cannon configurations on left/right sides. Uses season_cannon_att_def resistance attribute for cannon damage calculations.",
      "progression": "Chapters have indexed stages with increasing power requirements. Clearing a stage (part) transitions to next_part."
    },
    "rogue_mode": {
      "description": "Roguelike mode with procedurally-structured runs. Players progress through chapters, collecting goods (power-ups) along the way. Chapters have up to 5 monster waves (monster_refresh1-5) with timed intervals.",
      "goods_system": "Collectible items during runs provide temporary effects. Some are unique (only one held), some are loseable on failure.",
      "branching": "Main chapters have branching paths with this_reward for success and this_punishment for failure. next_starting determines progression."
    },
    "fate_dungeons": {
      "description": "Dungeon mode for farming fate card materials. Has difficulty_adjust for dynamic scaling, separate first_reward and daily_reward tracks, and boss encounters."
    }
