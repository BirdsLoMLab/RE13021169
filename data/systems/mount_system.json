  "battle_loading": {
    "function": "setPlayerMount",
    "game_script_lines": {
      "client_version": "199066-199067"
    },
    "code": "e.setPlayerMount = function(e) { e.mount = IS(S).use_look }",
    "description": "Mount is stored as a cosmetic look ID (use_look) on the player unit data. Mounts do not have combat unit representations; their stats are baked into the player's attributes."
  },
  "mount_level_system": {
    "description": "Mounts are leveled using EXP and materials. Higher levels provide attribute bonuses and unlock new mounts.",
    "exp_currency_id": 1008,
    "level_progression": {
      "code_location": "Lines 321241-321243",
      "formula": "needed_exp = configMount_level.getDataByKey(curLevel + 1).expend_exp - curexp"
    },
    "mount_unlock": {
      "description": "When mount_level.unlock > 0, reaching that level unlocks a new mount",
      "code_location": "Lines 321224-321225"
    },
    "star_milestones": {
      "description": "Levels with star=1 are milestone levels that unlock mounts (referenced in enable view line 321350)"
    }
  },
  "ability_system": {
    "description": "Three ability branches (id 1-3) that provide percentage-based attribute bonuses. Upgraded via gacha-like system with success rates.",
    "branches": 3,
    "upgrade_mechanics": {
      "currency_id": 1025,
      "code_location": "Lines 321258-321261",
      "process": [
        "1. Calculate total_level = sum of all ability branch levels",
        "2. Look up ConfigMount_abilitycost by total_level",
        "3. Pay cost (currency 1025)",
        "4. Roll success_rate (displayed as rate/100 %)",
        "5. If successful, random ability branch level increases",
        "6. success_guaranteed provides pity/guaranteed threshold"
      ]
    },
    "display": {
      "code_location": "Lines 321411-321417",
      "description": "Each ability shows its current level and the value_plus from ConfigMount_ability as a percentage bonus"
    }
  },
