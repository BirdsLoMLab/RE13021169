    "server_version": {
      "code": "t.setPlayerSpirit = function(t, e) { t.spirit = e }",
      "description": "Spirit data is stored as [spirit_id, spirit_level] array on the player list. The spirit info comes from ext data keys 12 and 13."
    },
    "client_version": {
      "code": "e.setPlayerSpirit = function(e) { var t = IS(B).getCurSpirit(); null != t && (e.spirit = [t.config_id, t.level]) }",
      "description": "Gets current spirit from GuardianSpiritDataCache and stores [config_id, level]"
    },
    "ext_key_mapping": {
      "12": "spirit[0] = spirit_id",
      "13": "spirit[1] = spirit_level"
    }
  },
  "combat_mechanics": {
    "spirit_damage_function": {
      "function_name": "spiritNormalHit",
      "code_location": "Lines 322981-323007",
      "description": "Spirit damage calculation with two branches: Spirit-vs-Spirit and Spirit-vs-Normal"
    },
    "spirit_vs_spirit": {
      "code_location": "Lines 322984-322988",
      "formula": "damage = round(ATT * (spirit_dam_add - spirit_dam_def + 1) * (1 - spirit_dam_def_final))",
      "variables": {
        "ATT": "Spirit's ATK stat",
        "spirit_dam_add": "Spirit's damage addition",
        "spirit_dam_def": "Target's spirit damage defense",
        "spirit_dam_def_final": "Target's final spirit damage defense (percentage)"
      }
    },
    "spirit_vs_normal": {
      "code_location": "Lines 322989-323004",
      "formula": "Uses att_dam ratios from ConfigSpirit_level to scale player's damage types",
      "process": [
        "1. Look up ConfigSpirit_level by spiritInfo[0] (spirit_id) and spiritInfo[1] (spirit_level)",
        "2. Parse att_dam array into ratio map: { type_id: ratio }",
        "3. Calculate base player damages (noCrit):",
        "   h = normalHurt(parent, target, 1, false) * att_dam[1] / 10000",
        "   M = normalDoubleHurt(parent, target, 1, false) * att_dam[2] / 10000",
        "   I = normalCounterHurt(parent, target, 1, false) * att_dam[3] / 10000",
        "   x = skillDamageHurt(parent, target, 1, false) * att_dam[4] / 10000",
        "4. Sum: damage = round(h + M + I + x)"
      ],
      "att_dam_keys": {
        "1": "Normal hit ratio (/ 10000)",
        "2": "Double hit / combo ratio (/ 10000)",
        "3": "Counter hit ratio (/ 10000)",
        "4": "Skill damage ratio (/ 10000)"
      }
    },
    "spirit_unit_creation": {
      "code_location": "Lines 193065-193094",
      "process": [
        "1. Create unit with base attributes from unit config",
        "2. Apply spirit_attr from ConfigSpirit_level:",
        "   For each [attr_id, value] in spirit_attr: set attrib baseValue",
        "3. Apply parent attribute inheritance if _attribs specified",
        "4. Calculate HP: base_hp + round(spirit_hp * (1 + spirit_hp_add))",
        "5. Calculate ATK: base_att + round(spirit_att * (1 + spirit_att_add))",
        "6. Load skill1 from ConfigSpirit_level as active skills",
        "7. Store spiritInfo = [spirit_id, spirit_level] on unit data"
      ]
    },
    "key_attributes": [
      {"name": "spirit_dam_add", "owner": "Spirit", "description": "Spirit's base damage addition value"},
      {"name": "spirit_dam_def", "owner": "Target", "description": "Target's defense against spirit damage"},
      {"name": "spirit_dam_def_final", "owner": "Target", "description": "Target's final spirit damage reduction (percentage)"},
      {"name": "spirit_hp", "owner": "Spirit", "description": "Spirit HP bonus added to base"},
      {"name": "spirit_hp_add", "owner": "Spirit", "description": "Spirit HP percentage multiplier"},
      {"name": "spirit_att", "owner": "Spirit", "description": "Spirit ATK bonus added to base"},
      {"name": "spirit_att_add", "owner": "Spirit", "description": "Spirit ATK percentage multiplier"},
      {"name": "spirit_att_dam", "owner": "Spirit", "description": "Spirit attack damage attribute"}
    ]
