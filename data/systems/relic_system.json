  "mechanics": {
    "relic_equip": {
      "description": "Relics are equipped into Relic_pos slots. Each relic provides both 'equip' bonuses (active when equipped) and 'own' bonuses (passive from ownership). equip_effect can grant skill/buff effects.",
      "network_protocol": "relic.relic_equip_c2s / relic.relic_equip_s2c"
    },
    "fate_fusion": {
      "description": "Fates can be fused using the Fate_fusion recipes. Multiple lower-quality fates combine into a higher-quality one, potentially transferring passive skill groups. mutually_exclusive prevents equipping conflicting fates."
    },
    "statue_investment": {
      "description": "Statues use a random roll system. Each upgrade spends currency (Statue_level.expend) and rolls from the Statue_attr pool with probability weights. Players can lock desirable attributes at extra cost (Statue_spend) to prevent rerolling them."
    }
  }
