{
  "name": "MetaAttrib",
  "sourceLine": 349636,
  "description": "The MetaAttrib class — how individual attribute values are calculated from base + additive + multiplicative + extra components",
  "overview": "Every combat attribute (ATK, HP, DEF, crit_rate, etc.) is a MetaAttrib instance. The final value is computed from four components: baseValue (from server), addValue (flat bonuses from buffs/effects), time (multiplicative modifier), and addExtraValue (flat post-multiplier bonus). The ConfigAttribute table defines per-attribute caps (up_limit) and display type (num_type).",

  "class_definition": {
    "sourceLine": 349639,
    "properties": {
      "config": "ConfigAttribute entry for this attribute (has up_limit, num_type, key, id, group, module)",
      "_baseValue": "Base value from server data (set during stat assembly)",
      "_addValue": "Additive flat bonus (accumulated from buffs, equipment effects, etc.)",
      "_addExtraValue": "Extra flat bonus applied AFTER multiplication",
      "_time": "Multiplicative modifier (starts at 1.0, stacks additively via addMultiples or multiplicatively via multiple)",
      "_value": "Cached final value",
      "_checkValue": "Anti-cheat check value (baseValue XOR 32)",
      "_change": "Dirty flag — recalculates on next .value access if true"
    }
  },

  "core_formula": {
    "sourceLine": 349642,
    "function": "_calculateValue(baseValue)",
    "formula": "value = roundInt(roundInt(baseValue + _addValue) * _time + _addExtraValue)",
    "steps": [
      {
        "step": 1,
        "description": "Add flat bonuses to base",
        "formula": "withAdd = roundInt(baseValue + _addValue)"
      },
      {
        "step": 2,
        "description": "Apply multiplicative modifier and extra value",
        "formula": "value = roundInt(withAdd * _time + _addExtraValue)"
      },
      {
        "step": 3,
        "description": "Apply attribute cap if defined",
        "formula": "if (config.up_limit != 0): value = min(value, config.up_limit)",
        "note": "Example: miss (evasion, id=1008) has up_limit=8000 (80%)"
      },
      {
        "step": 4,
        "description": "Convert to display percentage if num_type == 2",
        "formula": "if (config.num_type == 2): value = round(value / 10000)",
        "note": "num_type 2 means the value is stored as parts-per-10000 internally"
      },
      {
        "step": 5,
        "description": "Null-coalesce to 0",
        "formula": "value = value ?? 0"
      }
    ],
    "simplified": "final = min(roundInt(roundInt(base + addValue) * time + addExtraValue), up_limit)"
  },

  "modifier_methods": {
    "addValue": {
      "sourceLine": 349647,
      "description": "Add flat bonus to _addValue",
      "formula": "_addValue = round(_addValue + amount)",
      "note": "Used for flat stat bonuses (e.g., +500 ATK from buff)"
    },
    "addExtraValue": {
      "sourceLine": 349645,
      "description": "Add flat bonus to _addExtraValue (applied after multiplication)",
      "formula": "_addExtraValue = round(_addExtraValue + amount)",
      "note": "Post-multiplier flat bonus"
    },
    "addMultiples": {
      "sourceLine": 349649,
      "description": "Add to multiplicative modifier (additive stacking)",
      "formula": "_time = round(_time + amount)",
      "note": "E.g., addMultiples(0.5) changes _time from 1.0 to 1.5 (50% increase)"
    },
    "multiple": {
      "sourceLine": 349651,
      "description": "Multiply the multiplicative modifier (multiplicative stacking)",
      "formula": "_time = _time * amount",
      "note": "E.g., multiple(1.2) changes _time from 1.5 to 1.8"
    }
  },

  "baseValue_setter": {
    "sourceLine": 349668,
    "description": "Setting baseValue triggers normalization and anti-cheat",
    "steps": [
      "Null-coalesce to 0",
      "Convert to Number",
      "If NaN: set to 10000 if num_type==2, else 0",
      "Apply roundInt()",
      "Set _checkValue = 32 XOR baseValue (anti-cheat)",
      "Set _change = true (triggers recalculation)"
    ]
  },

  "anti_cheat": {
    "sourceLine": 349655,
    "function": "checkCheat()",
    "description": "Verifies attribute hasn't been tampered with in memory",
    "formula": "expected = _calculateValue(32 XOR _checkValue); if (value != expected) → log error"
  },

  "attribute_types": {
    "num_type_1": {
      "description": "Raw integer value (ATK, HP, DEF, speed, etc.)",
      "examples": ["att (1001)", "hp (1002)", "def (1024)"]
    },
    "num_type_2": {
      "description": "Percentage stored as parts-per-10000, divided by 10000 for display",
      "examples": ["crit_rate (1004)", "miss (1008)", "att_resist (1018)"],
      "note": "A baseValue of 5000 means 50% (0.5 after division). Default baseValue is 10000 (100% = 1.0) for these."
    }
  },

